# Database — PostgreSQL connection string
# Free options: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bhawani_jewellers?sslmode=require"

# JWT Secret — generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"

# Site URL — no trailing slash
# Local: http://localhost:3000
# Production: https://bhawani-jewellers.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Email (for contact form notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="info@bhawanijewellers.com"
